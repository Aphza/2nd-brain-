# Copy to .env and fill in. Keys are read from the environment only - never hardcoded.
# Provider priority for ai_metadata: Gemini -> AWS Bedrock -> Groq.

# 1) Gemini (tried first). Provide one or many; any of these forms works:
GEMINI_API_KEY=
# GEMINI_API_KEYS=key_one,key_two,key_three
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# GEMINI_MODEL=gemini-1.5-flash

# 2) AWS Bedrock (fallback when Gemini is exhausted / rate limited).
#    Uses a Bedrock API key passed as a bearer token.
AWS_BEDROCK_API_KEY=
# AWS_BEDROCK_REGION=us-east-1
# AWS_BEDROCK_MODEL=anthropic.claude-3-5-haiku-20241022-v1:0

# 3) Groq (last-resort fallback).
GROQ_API_KEY=
# GROQ_API_KEYS=key_one,key_two
# GROQ_MODEL=llama-3.3-70b-versatile
