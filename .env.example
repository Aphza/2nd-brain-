# Copy to .env and fill in. Credentials are read from the environment only -
# never hardcoded, never logged. Provider priority: Gemini -> AWS Bedrock -> Groq.

# 1) Gemini (tried first). Provide one or many; any of these forms works:
GEMINI_API_KEY=
# GEMINI_API_KEYS=key_one,key_two,key_three
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# GEMINI_MODEL=gemini-2.5-flash        # default; gemini-1.5-flash is retired

# 2) AWS Bedrock (fallback when Gemini is exhausted / rate limited).
#    Preferred: SigV4 with standard AWS credentials (boto3 if installed, else a
#    built-in HMAC signer). Bedrock Haiku 4.5 is on-demand via a cross-Region
#    inference profile, so the model id needs the "us." prefix and "-v1:0" suffix.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=                    # only for temporary/STS credentials
# AWS_BEDROCK_REGION=us-east-1
# AWS_BEDROCK_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
#
# Optional: a Bedrock bearer API key. If set alongside AWS creds, SigV4 is tried
# first and this is used only as a fallback. If it is the ONLY Bedrock credential,
# bearer auth is used directly.
# AWS_BEDROCK_API_KEY=

# 3) Groq (last-resort fallback).
GROQ_API_KEY=
# GROQ_API_KEYS=key_one,key_two
# GROQ_MODEL=llama-3.3-70b-versatile   # current/active as of 2026-06
